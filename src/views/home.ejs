<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - File Storage</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        /* Loading spinner animation */
        .btn-loading {
            position: relative;
            color: transparent !important;
            pointer-events: none;
        }
        
        .btn-loading::after {
            content: "";
            position: absolute;
            width: 16px;
            height: 16px;
            top: 50%;
            left: 50%;
            margin-left: -8px;
            margin-top: -8px;
            border: 2px solid transparent;
            border-top-color: currentColor;
            border-radius: 50%;
            animation: button-loading-spinner 0.6s linear infinite;
        }
        
        .btn-primary.btn-loading::after {
            border-top-color: #202124;
        }
        
        @keyframes button-loading-spinner {
            from { transform: rotate(0turn); }
            to { transform: rotate(1turn); }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a href="/home" class="navbar-brand">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#8ab4f8">
                <path d="M13 9h5.5L13 3.5V9M6 2h8l6 6v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2m0 18h12V9h-6V3H6v17z"/>
            </svg>
            File Storage
        </a>
        <div class="navbar-menu">
            <span style="color: #9aa0a6; margin-right: 16px;">Welcome, <%= user.username %></span>
            <form action="/log-out" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-secondary">Log Out</button>
            </form>
        </div>
    </nav>

    <div class="home-layout">
        <!-- Side Navigation -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h3>Folders</h3>
            </div>
            
            <div class="folder-tree">
                <%- include("partials/foldersTree", { foldersTree, path, nodeId: rootId, rootId, currentFolderId}) %>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="main-content">
            <!-- Breadcrumbs -->
            <div class="breadcrumbs">
                <% if (path && path.length > 0) { %>
                    <% path.forEach((folderId, index) => { %>
                        <% if (index === path.length - 1) { %>
                            <a href="/folders/<%= folderId %>" class="breadcrumb-item active"><%= foldersTree[folderId].name %></a>
                        <% } else { %>
                            <a href="/folders/<%= folderId %>" class="breadcrumb-item"><%= foldersTree[folderId].name %></a>
                            <svg class="breadcrumb-separator" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        <% } %>
                    <% }); %>
                <% } %>
            </div>

            <!-- Toolbar -->
            <div class="content-toolbar">
                <h2>Work</h2>
            </div>

            <!-- Folders Section -->
            <div class="content-section">
                <h3 class="section-title">Folders</h3>
                <div class="items-grid">
                    <% foldersTree[currentFolderId].children.forEach(childId => { %>
                        <% const folder = foldersTree[childId]; %>
                        <a href="/folders/<%= folder.id %>" class="item-card folder-card">
                            <svg class="item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#8ab4f8">
                                <path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
                            </svg>
                            <div class="item-info">
                                <h4><%= folder.name %></h4>
                                <p><%= folder.children.length + folder.files.length %> items</p>
                            </div>
                            <button class="btn-icon item-menu">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <circle cx="12" cy="5" r="2"/>
                                    <circle cx="12" cy="12" r="2"/>
                                    <circle cx="12" cy="19" r="2"/>
                                </svg>
                            </button>
                        </a>
                    <% }); %>

                    <div class="item-card folder-card add-new-card" id="newFolderBtn">
                        <svg class="item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#8ab4f8" stroke-width="2">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                            <line x1="12" y1="11" x2="12" y2="17"/>
                            <line x1="9" y1="14" x2="15" y2="14"/>
                        </svg>
                        <div class="item-info">
                            <h4>New Folder</h4>
                            <p>Create a new folder</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Files Section -->
            <div class="content-section">
                <h3 class="section-title">Files</h3>
                <div class="items-grid">
                    <% foldersTree[currentFolderId].files.forEach(file => { %>
                        <div class="item-card file-card">
                            <svg class="item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#8ab4f8">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/>
                                <path d="M14 2v6h6"/>
                            </svg>
                            <div class="item-info">
                                <h4><%= file.name %></h4>
                                <p><%= (file.size / 1024).toFixed(1) %> KB • <%= new Date(file.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                            </div>
                            <button class="btn-icon item-menu">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <circle cx="12" cy="5" r="2"/>
                                    <circle cx="12" cy="12" r="2"/>
                                    <circle cx="12" cy="19" r="2"/>
                                </svg>
                            </button>
                        </div>
                    <% }); %>

                    <div class="item-card file-card add-new-card" id="uploadFileBtn">
                        <svg class="item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#8ab4f8" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
                        </svg>
                        <div class="item-info">
                            <h4>Upload File</h4>
                            <p>Add a new file</p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- New Folder Modal -->
    <div id="folderModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Create New Folder</h3>
                <button class="modal-close" id="closeFolderModal">&times;</button>
            </div>
            <form action="/folders/<%= currentFolderId %>" method="POST">
                <div class="form-group">
                    <label for="folderName">Folder Name</label>
                    <input type="text" id="folderName" name="name" placeholder="Enter folder name" required>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancelFolderModal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="createFolderBtn">Create Folder</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Upload File Modal -->
    <div id="fileModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Upload File</h3>
                <button class="modal-close" id="closeFileModal">&times;</button>
            </div>
            <form action="/files/<%= currentFolderId %>" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="fileInput">Choose File</label>
                    <input type="file" id="fileInput" name="file" required>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancelFileModal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="uploadFileSubmitBtn">Upload</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Modal elements
        const folderModal = document.getElementById('folderModal');
        const fileModal = document.getElementById('fileModal');
        const newFolderBtn = document.getElementById('newFolderBtn');
        const uploadFileBtn = document.getElementById('uploadFileBtn');

        // Open modals
        newFolderBtn.addEventListener('click', () => {
            folderModal.style.display = 'flex';
        });

        uploadFileBtn.addEventListener('click', () => {
            fileModal.style.display = 'flex';
        });

        // Close folder modal
        document.getElementById('closeFolderModal').addEventListener('click', () => {
            folderModal.style.display = 'none';
        });

        document.getElementById('cancelFolderModal').addEventListener('click', () => {
            folderModal.style.display = 'none';
        });

        // Close file modal
        document.getElementById('closeFileModal').addEventListener('click', () => {
            fileModal.style.display = 'none';
        });

        document.getElementById('cancelFileModal').addEventListener('click', () => {
            fileModal.style.display = 'none';
        });

        // Close on outside click
        window.addEventListener('click', (e) => {
            if (e.target === folderModal) {
                folderModal.style.display = 'none';
            }
            if (e.target === fileModal) {
                fileModal.style.display = 'none';
            }
        });

        // Handle folder form submission
        const folderForm = document.querySelector('#folderModal form');
        const createFolderBtn = document.getElementById('createFolderBtn');
        
        folderForm.addEventListener('submit', (e) => {
            createFolderBtn.disabled = true;
            createFolderBtn.classList.add('btn-loading');
        });

        // Handle file upload form submission
        const fileForm = document.querySelector('#fileModal form');
        const uploadFileSubmitBtn = document.getElementById('uploadFileSubmitBtn');
        
        fileForm.addEventListener('submit', (e) => {
            uploadFileSubmitBtn.disabled = true;
            uploadFileSubmitBtn.classList.add('btn-loading');
        });
    </script>
</body>
</html>
