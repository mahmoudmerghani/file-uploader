<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - File Storage</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        /* Loading spinner animation */
        .btn-loading {
            position: relative;
            color: transparent !important;
            pointer-events: none;
        }
        
        .btn-loading::after {
            content: "";
            position: absolute;
            width: 16px;
            height: 16px;
            top: 50%;
            left: 50%;
            margin-left: -8px;
            margin-top: -8px;
            border: 2px solid transparent;
            border-top-color: currentColor;
            border-radius: 50%;
            animation: button-loading-spinner 0.6s linear infinite;
        }
        
        .btn-primary.btn-loading::after {
            border-top-color: #202124;
        }
        
        @keyframes button-loading-spinner {
            from { transform: rotate(0turn); }
            to { transform: rotate(1turn); }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#8ab4f8">
                <path d="M13 9h5.5L13 3.5V9M6 2h8l6 6v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2m0 18h12V9h-6V3H6v17z"/>
            </svg>
            File Storage
        </a>
        <div class="navbar-menu">
            <span style="color: #9aa0a6; margin-right: 16px;">Welcome, <%= user.username %></span>
            <form action="/log-out" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-secondary">Log Out</button>
            </form>
        </div>
    </nav>

    <div class="home-layout">
        <!-- Side Navigation -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h3>Folders</h3>
            </div>
            
            <div class="folder-tree">
                <%- include("partials/foldersTree", { foldersTree, path, nodeId: rootId, rootId, currentFolderId}) %>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="main-content">
            <!-- Breadcrumbs -->
            <div class="breadcrumbs">
                <% if (path && path.length > 0) { %>
                    <% path.forEach((folderId, index) => { %>
                        <% if (index === path.length - 1) { %>
                            <a href="/folders/<%= folderId %>" class="breadcrumb-item active"><%= foldersTree[folderId].name %></a>
                        <% } else { %>
                            <a href="/folders/<%= folderId %>" class="breadcrumb-item"><%= foldersTree[folderId].name %></a>
                            <svg class="breadcrumb-separator" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        <% } %>
                    <% }); %>
                <% } %>
            </div>

            <!-- Toolbar -->
            <div class="content-toolbar">
                <h2>Work</h2>
            </div>

            <!-- Folders Section -->
            <div class="content-section">
                <h3 class="section-title">Folders</h3>
                <div class="items-grid">
                    <% foldersTree[currentFolderId].children.forEach(childId => { %>
                        <% const folder = foldersTree[childId]; %>
                        <div class="item-card-wrapper">
                            <a href="/folders/<%= folder.id %>" class="item-card folder-card">
                                <svg class="item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#8ab4f8">
                                    <path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
                                </svg>
                                <div class="item-info">
                                    <h4><%= folder.name %></h4>
                                    <p><%= folder.children.length + folder.files.length %> items • <span class="format-date" data-date="<%= folder.createdAt %>"></span></p>
                                </div>
                                <button class="btn-icon item-menu" data-folder-id="<%= folder.id %>" data-folder-name="<%= folder.name %>">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                        <circle cx="12" cy="5" r="2"/>
                                        <circle cx="12" cy="12" r="2"/>
                                        <circle cx="12" cy="19" r="2"/>
                                    </svg>
                                </button>
                            </a>
                            <div class="item-dropdown-menu" data-menu-for="<%= folder.id %>">
                                <button class="dropdown-item rename-folder">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                    Rename
                                </button>
                                <button class="dropdown-item share-folder">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="18" cy="5" r="3"/>
                                        <circle cx="6" cy="12" r="3"/>
                                        <circle cx="18" cy="19" r="3"/>
                                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                                    </svg>
                                    Share
                                </button>
                                <div class="dropdown-divider"></div>
                                <button class="dropdown-item delete-folder" data-folder-id="<%= folder.id %>" data-folder-name="<%= folder.name %>">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                        <line x1="10" y1="11" x2="10" y2="17"/>
                                        <line x1="14" y1="11" x2="14" y2="17"/>
                                    </svg>
                                    Delete
                                </button>
                            </div>
                        </div>
                    <% }); %>

                    <div class="item-card folder-card add-new-card" id="newFolderBtn">
                        <svg class="item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#8ab4f8" stroke-width="2">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                            <line x1="12" y1="11" x2="12" y2="17"/>
                            <line x1="9" y1="14" x2="15" y2="14"/>
                        </svg>
                        <div class="item-info">
                            <h4>New Folder</h4>
                            <p>Create a new folder</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Files Section -->
            <div class="content-section">
                <h3 class="section-title">Files</h3>
                <div class="items-grid">
                    <% foldersTree[currentFolderId].files.forEach(file => { %>
                        <div class="item-card-wrapper">
                            <div class="item-card file-card" title="<%= file.name %>">
                                <svg class="item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#8ab4f8">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/>
                                    <path d="M14 2v6h6"/>
                                </svg>
                                <div class="item-info">
                                    <h4><%= file.name %></h4>
                                    <p><%= (file.size / 1024).toFixed(1) %> KB • <span class="format-date" data-date="<%= file.createdAt %>"></span></p>
                                </div>
                                <button class="btn-icon item-menu file-menu-btn" data-file-id="<%= file.id %>" data-file-name="<%= file.name %>">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                        <circle cx="12" cy="5" r="2"/>
                                        <circle cx="12" cy="12" r="2"/>
                                        <circle cx="12" cy="19" r="2"/>
                                    </svg>
                                </button>
                            </div>
                            <div class="item-dropdown-menu" data-menu-for="file-<%= file.id %>">
                                <button class="dropdown-item rename-file">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                    Rename
                                </button>
                                <button class="dropdown-item download-file" data-file-id="<%= file.id %>">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                        <polyline points="7 10 12 15 17 10"/>
                                        <line x1="12" y1="15" x2="12" y2="3"/>
                                    </svg>
                                    Download
                                </button>
                                <div class="dropdown-divider"></div>
                                <button class="dropdown-item delete-file delete-file-item" data-file-id="<%= file.id %>" data-file-name="<%= file.name %>">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                        <line x1="10" y1="11" x2="10" y2="17"/>
                                        <line x1="14" y1="11" x2="14" y2="17"/>
                                    </svg>
                                    Delete
                                </button>
                            </div>
                        </div>
                    <% }); %>

                    <div class="item-card file-card add-new-card" id="uploadFileBtn">
                        <svg class="item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#8ab4f8" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
                        </svg>
                        <div class="item-info">
                            <h4>Upload File</h4>
                            <p>Add a new file</p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- New Folder Modal -->
    <div id="folderModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Create New Folder</h3>
                <button class="modal-close" id="closeFolderModal">&times;</button>
            </div>
            <form action="/folders/<%= currentFolderId %>" method="POST">
                <div class="form-group">
                    <label for="folderName">Folder Name</label>
                    <input type="text" id="folderName" name="name" placeholder="Enter folder name" required>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancelFolderModal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="createFolderBtn">Create Folder</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Upload File Modal -->
    <div id="fileModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Upload File</h3>
                <button class="modal-close" id="closeFileModal">&times;</button>
            </div>
            <form action="/files/<%= currentFolderId %>" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="fileInput">Choose File</label>
                    <input type="file" id="fileInput" name="file" required>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancelFileModal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="uploadFileSubmitBtn">Upload</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Rename Folder Modal -->
    <div id="renameFolderModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Rename Folder</h3>
                <button class="modal-close" id="closeRenameFolderModal">&times;</button>
            </div>
            <form id="renameFolderForm" method="POST">
                <div class="form-group">
                    <label for="renameFolderInput">New Folder Name</label>
                    <input type="text" id="renameFolderInput" name="name" placeholder="Enter new folder name" required>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancelRenameFolderModal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="renameFolderBtn">Rename</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Folder Modal -->
    <div id="deleteFolderModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Delete Folder</h3>
                <button class="modal-close" id="closeDeleteFolderModal">&times;</button>
            </div>
            <form id="deleteFolderForm" method="POST">
                <div class="form-group">
                    <p style="color: #9aa0a6; margin-bottom: 16px;">Are you sure you want to delete "<span id="deleteFolderName"></span>"?</p>
                    <p style="color: #f28b82; font-size: 14px;">All files in this folder will be deleted. This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancelDeleteFolderModal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="deleteFolderBtn" style="background-color: #f28b82; border-color: #f28b82;">Delete</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Rename File Modal -->
    <div id="renameFileModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Rename File</h3>
                <button class="modal-close" id="closeRenameFileModal">&times;</button>
            </div>
            <form id="renameFileForm" method="POST">
                <div class="form-group">
                    <label for="renameFileInput">New File Name</label>
                    <input type="text" id="renameFileInput" name="name" placeholder="Enter new file name" required>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancelRenameFileModal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="renameFileBtn">Rename</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete File Modal -->
    <div id="deleteFileModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Delete File</h3>
                <button class="modal-close" id="closeDeleteFileModal">&times;</button>
            </div>
            <form id="deleteFileForm" method="POST">
                <div class="form-group">
                    <p style="color: #9aa0a6; margin-bottom: 16px;">Are you sure you want to delete "<span id="deleteFileName"></span>"?</p>
                    <p style="color: #f28b82; font-size: 14px;">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancelDeleteFileModal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="deleteFileBtn" style="background-color: #f28b82; border-color: #f28b82;">Delete</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Format dates in user's local timezone
        document.querySelectorAll('.format-date').forEach(element => {
            const dateString = element.getAttribute('data-date');
            if (dateString) {
                const date = new Date(dateString);
                element.textContent = date.toLocaleDateString('en-US', { 
                    month: 'short', 
                    day: 'numeric', 
                    year: 'numeric' 
                });
            }
        });

        // Modal elements
        const folderModal = document.getElementById('folderModal');
        const fileModal = document.getElementById('fileModal');
        const renameFolderModal = document.getElementById('renameFolderModal');
        const deleteFolderModal = document.getElementById('deleteFolderModal');
        const renameFileModal = document.getElementById('renameFileModal');
        const deleteFileModal = document.getElementById('deleteFileModal');
        const newFolderBtn = document.getElementById('newFolderBtn');
        const uploadFileBtn = document.getElementById('uploadFileBtn');

        // Open modals
        newFolderBtn.addEventListener('click', () => {
            folderModal.style.display = 'flex';
        });

        uploadFileBtn.addEventListener('click', () => {
            fileModal.style.display = 'flex';
        });

        // Close folder modal
        document.getElementById('closeFolderModal').addEventListener('click', () => {
            folderModal.style.display = 'none';
        });

        document.getElementById('cancelFolderModal').addEventListener('click', () => {
            folderModal.style.display = 'none';
        });

        // Close file modal
        document.getElementById('closeFileModal').addEventListener('click', () => {
            fileModal.style.display = 'none';
        });

        document.getElementById('cancelFileModal').addEventListener('click', () => {
            fileModal.style.display = 'none';
        });

        // Close rename folder modal
        document.getElementById('closeRenameFolderModal').addEventListener('click', () => {
            renameFolderModal.style.display = 'none';
        });

        document.getElementById('cancelRenameFolderModal').addEventListener('click', () => {
            renameFolderModal.style.display = 'none';
        });

        // Close delete folder modal
        document.getElementById('closeDeleteFolderModal').addEventListener('click', () => {
            deleteFolderModal.style.display = 'none';
        });

        document.getElementById('cancelDeleteFolderModal').addEventListener('click', () => {
            deleteFolderModal.style.display = 'none';
        });

        // Close rename file modal
        document.getElementById('closeRenameFileModal').addEventListener('click', () => {
            renameFileModal.style.display = 'none';
        });

        document.getElementById('cancelRenameFileModal').addEventListener('click', () => {
            renameFileModal.style.display = 'none';
        });

        // Close delete file modal
        document.getElementById('closeDeleteFileModal').addEventListener('click', () => {
            deleteFileModal.style.display = 'none';
        });

        document.getElementById('cancelDeleteFileModal').addEventListener('click', () => {
            deleteFileModal.style.display = 'none';
        });

        // Close on outside click
        window.addEventListener('click', (e) => {
            if (e.target === folderModal) {
                folderModal.style.display = 'none';
            }
            if (e.target === fileModal) {
                fileModal.style.display = 'none';
            }
            if (e.target === renameFolderModal) {
                renameFolderModal.style.display = 'none';
            }
            if (e.target === deleteFolderModal) {
                deleteFolderModal.style.display = 'none';
            }
            if (e.target === renameFileModal) {
                renameFileModal.style.display = 'none';
            }
            if (e.target === deleteFileModal) {
                deleteFileModal.style.display = 'none';
            }
        });

        // Handle folder form submission
        const folderForm = document.querySelector('#folderModal form');
        const createFolderBtn = document.getElementById('createFolderBtn');
        
        folderForm.addEventListener('submit', (e) => {
            createFolderBtn.disabled = true;
            createFolderBtn.classList.add('btn-loading');
        });

        // Handle file upload form submission
        const fileForm = document.querySelector('#fileModal form');
        const uploadFileSubmitBtn = document.getElementById('uploadFileSubmitBtn');
        
        fileForm.addEventListener('submit', (e) => {
            uploadFileSubmitBtn.disabled = true;
            uploadFileSubmitBtn.classList.add('btn-loading');
        });

        // Folder menu dropdown functionality
        const folderMenuButtons = document.querySelectorAll('.folder-card .item-menu');
        let currentOpenMenu = null;

        folderMenuButtons.forEach(button => {
            button.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                
                const folderId = button.getAttribute('data-folder-id');
                const menu = document.querySelector(`.item-dropdown-menu[data-menu-for="${folderId}"]`);
                
                // Close currently open menu if different
                if (currentOpenMenu && currentOpenMenu !== menu) {
                    currentOpenMenu.classList.remove('active');
                }
                
                // Toggle current menu
                menu.classList.toggle('active');
                currentOpenMenu = menu.classList.contains('active') ? menu : null;
            });
        });

        // Close menus when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.item-dropdown-menu') && !e.target.closest('.item-menu')) {
                document.querySelectorAll('.item-dropdown-menu.active').forEach(menu => {
                    menu.classList.remove('active');
                });
                currentOpenMenu = null;
            }
        });

        // Handle menu item clicks
        document.querySelectorAll('.rename-folder').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const menu = e.target.closest('.item-dropdown-menu');
                const folderId = menu.getAttribute('data-menu-for');
                const button = document.querySelector(`.item-menu[data-folder-id="${folderId}"]`);
                const folderName = button.getAttribute('data-folder-name');
                
                // Set form action and populate input
                document.getElementById('renameFolderForm').action = `/folders/${folderId}/rename`;
                document.getElementById('renameFolderInput').value = folderName;
                
                // Show modal
                renameFolderModal.style.display = 'flex';
                menu.classList.remove('active');
                
                // Focus the input
                setTimeout(() => {
                    document.getElementById('renameFolderInput').select();
                }, 100);
            });
        });

        document.querySelectorAll('.move-folder').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const menu = e.target.closest('.item-dropdown-menu');
                const folderId = menu.getAttribute('data-menu-for');
                alert(`Move folder (ID: ${folderId})`);
                menu.classList.remove('active');
            });
        });

        document.querySelectorAll('.share-folder').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const menu = e.target.closest('.item-dropdown-menu');
                const folderId = menu.getAttribute('data-menu-for');
                alert(`Share folder (ID: ${folderId})`);
                menu.classList.remove('active');
            });
        });

        document.querySelectorAll('.delete-folder').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const folderId = btn.getAttribute('data-folder-id');
                const folderName = btn.getAttribute('data-folder-name');
                
                // Set form action and populate folder name
                document.getElementById('deleteFolderForm').action = `/folders/${folderId}/delete`;
                document.getElementById('deleteFolderName').textContent = folderName;
                
                // Show modal
                deleteFolderModal.style.display = 'flex';
                const menu = e.target.closest('.item-dropdown-menu');
                menu.classList.remove('active');
            });
        });

        // Handle rename form submission
        const renameFolderForm = document.getElementById('renameFolderForm');
        const renameFolderBtn = document.getElementById('renameFolderBtn');
        
        renameFolderForm.addEventListener('submit', (e) => {
            renameFolderBtn.disabled = true;
            renameFolderBtn.classList.add('btn-loading');
        });

        // Handle delete form submission
        const deleteFolderForm = document.getElementById('deleteFolderForm');
        const deleteFolderBtn = document.getElementById('deleteFolderBtn');
        
        deleteFolderForm.addEventListener('submit', (e) => {
            deleteFolderBtn.disabled = true;
            deleteFolderBtn.classList.add('btn-loading');
        });

        // File menu dropdown functionality
        const fileMenuButtons = document.querySelectorAll('.file-menu-btn');

        fileMenuButtons.forEach(button => {
            button.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                
                const fileId = button.getAttribute('data-file-id');
                const menu = document.querySelector(`.item-dropdown-menu[data-menu-for="file-${fileId}"]`);
                
                // Close currently open menu if different
                if (currentOpenMenu && currentOpenMenu !== menu) {
                    currentOpenMenu.classList.remove('active');
                }
                
                // Toggle current menu
                menu.classList.toggle('active');
                currentOpenMenu = menu.classList.contains('active') ? menu : null;
            });
        });

        // Handle file menu item clicks
        document.querySelectorAll('.rename-file').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const menu = e.target.closest('.item-dropdown-menu');
                const menuFor = menu.getAttribute('data-menu-for');
                const fileId = menuFor.replace('file-', '');
                const button = document.querySelector(`.file-menu-btn[data-file-id="${fileId}"]`);
                const fileName = button.getAttribute('data-file-name');
                
                // Set form action and populate input
                document.getElementById('renameFileForm').action = `/files/${fileId}/rename`;
                document.getElementById('renameFileInput').value = fileName;
                
                // Show modal
                renameFileModal.style.display = 'flex';
                menu.classList.remove('active');
                
                // Focus the input
                setTimeout(() => {
                    document.getElementById('renameFileInput').select();
                }, 100);
            });
        });

        document.querySelectorAll('.download-file').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const fileId = btn.getAttribute('data-file-id');
                
                // Create a temporary link and trigger download
                window.location.href = `/files/${fileId}/download`;
                
                const menu = e.target.closest('.item-dropdown-menu');
                menu.classList.remove('active');
            });
        });

        document.querySelectorAll('.delete-file').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const fileId = btn.getAttribute('data-file-id');
                const fileName = btn.getAttribute('data-file-name');
                
                // Set form action and populate file name
                document.getElementById('deleteFileForm').action = `/files/${fileId}/delete`;
                document.getElementById('deleteFileName').textContent = fileName;
                
                // Show modal
                deleteFileModal.style.display = 'flex';
                const menu = e.target.closest('.item-dropdown-menu');
                menu.classList.remove('active');
            });
        });

        // Handle rename file form submission
        const renameFileForm = document.getElementById('renameFileForm');
        const renameFileBtn = document.getElementById('renameFileBtn');
        
        renameFileForm.addEventListener('submit', (e) => {
            renameFileBtn.disabled = true;
            renameFileBtn.classList.add('btn-loading');
        });

        // Handle delete file form submission
        const deleteFileForm = document.getElementById('deleteFileForm');
        const deleteFileBtn = document.getElementById('deleteFileBtn');
        
        deleteFileForm.addEventListener('submit', (e) => {
            deleteFileBtn.disabled = true;
            deleteFileBtn.classList.add('btn-loading');
        });
    </script>
</body>
</html>
