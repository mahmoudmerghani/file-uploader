<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Share Link Created - File Storage</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        .share-container {
            max-width: 600px;
            margin: 80px auto;
            padding: 40px;
            background: #303134;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        .share-header {
            text-align: center;
            margin-bottom: 32px;
        }

        .share-header svg {
            width: 64px;
            height: 64px;
            fill: #8ab4f8;
            margin-bottom: 16px;
        }

        .share-header h1 {
            color: #e8eaed;
            font-size: 24px;
            margin: 0 0 8px 0;
        }

        .share-header p {
            color: #9aa0a6;
            margin: 0;
        }

        .link-container {
            background: #202124;
            border: 1px solid #5f6368;
            border-radius: 4px;
            padding: 16px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .link-text {
            flex: 1;
            color: #8ab4f8;
            word-break: break-all;
            font-family: 'Courier New', monospace;
            font-size: 14px;
        }

        .copy-btn {
            background: #8ab4f8;
            color: #202124;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 500;
            white-space: nowrap;
            transition: background-color 0.2s;
        }

        .copy-btn:hover {
            background: #aecbfa;
        }

        .copy-btn.copied {
            background: #81c995;
        }

        .info-box {
            background: rgba(138, 180, 248, 0.1);
            border-left: 4px solid #8ab4f8;
            padding: 16px;
            border-radius: 4px;
            margin-bottom: 24px;
        }

        .info-box p {
            color: #9aa0a6;
            margin: 0;
            font-size: 14px;
            line-height: 1.5;
        }

        .actions {
            display: flex;
            gap: 12px;
            justify-content: center;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#8ab4f8">
                <path d="M13 9h5.5L13 3.5V9M6 2h8l6 6v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2m0 18h12V9h-6V3H6v17z"/>
            </svg>
            File Storage
        </a>
        <div class="navbar-menu">
            <a href="/" class="btn btn-secondary">Back to Home</a>
        </div>
    </nav>

    <div class="share-container">
        <div class="share-header">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"/>
            </svg>
            <h1>Share Link Created!</h1>
            <p>Anyone with this link can access "<%= folderName %>"</p>
        </div>

        <div class="link-container">
            <div class="link-text" id="shareLink"><%= link %></div>
            <button class="copy-btn" id="copyBtn">Copy</button>
        </div>

        <div class="info-box">
            <p>
                <strong>Share this link</strong> with anyone you want to give access to this folder. 
                The link will expire according to the period you selected.
            </p>
        </div>

        <div class="actions">
            <a href="/" class="btn btn-primary">Done</a>
        </div>
    </div>

    <script>
        const copyBtn = document.getElementById('copyBtn');
        const shareLink = document.getElementById('shareLink');

        copyBtn.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(shareLink.textContent);
                copyBtn.textContent = 'Copied!';
                copyBtn.classList.add('copied');
                
                setTimeout(() => {
                    copyBtn.textContent = 'Copy';
                    copyBtn.classList.remove('copied');
                }, 2000);
            } catch (err) {
                // Fallback for older browsers
                const textArea = document.createElement('textarea');
                textArea.value = shareLink.textContent;
                textArea.style.position = 'fixed';
                textArea.style.left = '-999999px';
                document.body.appendChild(textArea);
                textArea.select();
                try {
                    document.execCommand('copy');
                    copyBtn.textContent = 'Copied!';
                    copyBtn.classList.add('copied');
                    
                    setTimeout(() => {
                        copyBtn.textContent = 'Copy';
                        copyBtn.classList.remove('copied');
                    }, 2000);
                } catch (err) {
                    console.error('Failed to copy:', err);
                }
                document.body.removeChild(textArea);
            }
        });
    </script>
</body>
</html>
